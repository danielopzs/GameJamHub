# Copy to .env for a hosted deployment. Never commit .env.
PORT=3001
DATA_DIR=.data
VAPID_SUBJECT=mailto:organizador@example.com
# Set a strong password in your hosting provider's secrets. Username: jam.
APP_PASSWORD=
# Local organizer session: enable only when serving behind HTTPS.
COOKIE_SECURE=0
# Production mode requires APP_PASSWORD.
NODE_ENV=development

# Supabase + Netlify Free: public browser configuration only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key can be used instead: VITE_SUPABASE_ANON_KEY=
