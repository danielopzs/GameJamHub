{
  "name": "game-jam-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "format": "prettier --write src server scripts",
    "build:static": "tsc -b && vite build --mode static && node scripts/build-sw.mjs",
    "build:cloud": "node scripts/check-public-config.mjs && tsc -b && vite build --mode cloud && node scripts/build-sw.mjs",
    "dev:cloud": "vite --host 0.0.0.0 --mode cloud",
    "test:ui": "playwright test",
    "test:db": "bash scripts/test-supabase.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
